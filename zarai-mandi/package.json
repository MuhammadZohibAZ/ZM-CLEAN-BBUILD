{
  "name": "zarai-mandi-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:api": "npm --prefix api run dev",
    "dev:frontend": "npm --prefix app run dev",
    "dev": "concurrently --kill-others-on-fail -n \"API,FRONTEND\" -c \"yellow,cyan\" \"npm run dev:api\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
