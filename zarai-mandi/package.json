{
  "name": "zarai-mandi-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cmd /c \"cd backend && call run_backend.bat\"",
    "dev:api": "npm --prefix api run dev",
    "dev:frontend": "npm --prefix app run dev",
    "dev": "concurrently -k -n \"TTS,API,FRONTEND\" -c \"magenta,yellow,cyan\" \"npm run dev:backend\" \"npm run dev:api\" \"npm run dev:frontend\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
